{
  "name": "ufo-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:maplibre && vite",
    "build": "npm run prepare:maplibre && npm run build:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "tsx scripts/validate-data.ts",
    "build:data": "tsx scripts/build-data.ts",
    "prepare:maplibre": "node -e \"const f=require('fs');f.mkdirSync('public/maplibre',{recursive:true});for(const n of ['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs'])f.copyFileSync('node_modules/maplibre-gl/dist/'+n,'public/maplibre/'+n)\""
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "maplibre-gl": "^6.19.0"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^2.0.0-beta.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}