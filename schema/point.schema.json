{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/<user>/ufo-map/schema/point.schema.json",
  "title": "UFO Map point collection",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "required": ["uk", "en"],
      "properties": {
        "uk": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ]
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "Point" }, "coordinates": { "$ref": "#/$defs/position" } }
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "LineString" },
            "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
          }
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } }
            }
          }
        }
      ]
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": { "$ref": "#/$defs/geometry" },
        "properties": {
          "type": "object",
          "required": [
            "id", "title", "description", "category", "added_at", "source_type",
            "sources", "credibility", "precision_m", "status"
          ],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z]{2}-[a-z]{2,4}-[0-9]{4}$" },
            "title": { "$ref": "#/$defs/i18n" },
            "description": { "$ref": "#/$defs/i18n" },
            "category": {
              "enum": [
                "ufo_sighting", "energy_anomaly", "place_of_power", "magnetic_anomaly",
                "crop_circle", "ley_line", "paranormal", "other"
              ]
            },
            "observed_at": {
              "type": ["string", "null"],
              "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
            },
            "added_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "source_type": { "enum": ["ufologist", "esoteric", "eyewitness", "media", "measurement"] },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^https?://" }
            },
            "credibility": { "type": "integer", "minimum": 1, "maximum": 5 },
            "precision_m": { "type": "integer", "minimum": 1 },
            "reporter": { "type": "string" },
            "region": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "media": { "type": "array", "items": { "type": "string" } },
            "status": { "enum": ["published", "disputed", "debunked"] },
            "safety_note": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
